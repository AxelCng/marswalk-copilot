# Copiar como .env en la raíz del repo (en el servidor) y completar. .env NO se sube a git.

# Dominio público. Sin dominio propio sirve sslip.io con la IP del servidor:
#   IP 140.238.10.20  ->  DOMINIO=140-238-10-20.sslip.io
DOMINIO=

# API key de Groq (gratis, sin tarjeta): https://console.groq.com/keys
GROQ_API_KEY=

# Modelo de Groq con tool use (lista: https://console.groq.com/docs/models)
MODELO=llama-3.3-70b-versatile
