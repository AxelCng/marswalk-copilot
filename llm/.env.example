# Copy this file as .env and set your values
OLLAMA_URL=http://localhost:11434
MODEL=qwen2.5:3b
# Real engine (also serves /chat). For the test mock: http://127.0.0.1:8001
# Use 127.0.0.1 and not localhost: on Windows localhost tries IPv6 first and is slower.
API_URL=http://127.0.0.1:8000
